{
  "name": "@zeyos/zx",
  "version": "2.1.0",
  "description": "Dependency-free, accessible UI component library for ZeyOS business applications.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://zx.zeyos.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeyos/zx.git"
  },
  "bugs": {
    "url": "https://github.com/zeyos/zx/issues"
  },
  "keywords": [
    "zeyos",
    "ui",
    "components",
    "design-system",
    "accessibility",
    "wai-aria",
    "vanilla-js",
    "erp"
  ],
  "sideEffects": [
    "*.css",
    "./dist/zx.global.js",
    "./dist/zx.global.min.js",
    "./dist/zx-compat.global.js",
    "./dist/zx-compat.global.min.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/zx.esm.js"
    },
    "./zeyos": {
      "types": "./dist/types/zeyos/index.d.ts",
      "default": "./dist/zx-zeyos.esm.js"
    },
    "./compat": {
      "types": "./dist/types/compat/index.d.ts",
      "default": "./dist/zx-compat.esm.js"
    },
    "./global": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/zx.global.js"
    },
    "./compat-global": {
      "types": "./dist/types/compat/index.d.ts",
      "default": "./dist/zx-compat.global.js"
    },
    "./zx.css": "./dist/zx.css",
    "./zx.min.css": "./dist/zx.min.css",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "main": "./dist/zx.esm.js",
  "module": "./dist/zx.esm.js",
  "style": "./dist/zx.css",
  "files": [
    "dist",
    "dist/types",
    "docs/llms.md",
    "docs/llms.txt",
    "docs/api.json",
    "CHANGELOG.md",
    "README.md",
    "MIGRATION.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "serve": "node tools/serve.js",
    "serve:site": "SERVE_ROOT=site node tools/serve.js",
    "build": "node tools/build.js",
    "build:site": "node tools/build-api.js && node tools/build-site.js",
    "test": "node --test && node tests/lint-tokens.js",
    "prepublishOnly": "npm test && npm run build",
    "build:api": "node tools/build-api.js",
    "build:types": "tsc --project tsconfig.json",
    "test:browser": "node tools/run-smoke.js"
  },
  "devDependencies": {
    "esbuild": "latest",
    "playwright-core": "^1.62.1",
    "typescript": "^7.0.2"
  },
  "types": "./dist/types/index.d.ts"
}
